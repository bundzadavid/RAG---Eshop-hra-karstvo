    <owl:Ontology rdf:about="http://example.org/hrackarstvo-eshop">
        <rdfs:comment xml:lang="sk">Ontológia internetového obchodu s hračkami: katalóg, sklad, zákazníci, objednávky, platby a doručenie.</rdfs:comment>
        <rdfs:label xml:lang="sk">Hračkárstvo e-shop – rozšírená ontológia</rdfs:label>
    </owl:Ontology>
    


